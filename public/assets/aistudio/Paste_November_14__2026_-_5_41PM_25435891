      document.getElementById('stat-range').innerText = `Campo ±15%: R$ ${stats.lowerLimit.toLocaleString('pt-BR')} a R$ ${stats.upperLimit.toLocaleString('pt-BR')}`;
      document.getElementById('stat-rent-val').innerText = `R$ ${stats.suggestedRentalValue.toLocaleString('pt-BR')} / mês`;
      document.getElementById('stat-cv').innerText = `CV: ${stats.coefficientOfVariation}%`;
