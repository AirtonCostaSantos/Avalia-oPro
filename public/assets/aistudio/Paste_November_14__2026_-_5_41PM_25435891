    // Busca de Endereço via CEP (ViaCEP API)
    function lookupCep() {
      const cepField = document.getElementById('inp-zip');
      const cleanCep = cepField.value.replace(/\D/g, '');
      if (cleanCep.length !== 8) return;

      const loading = document.getElementById('cep-loading');
      loading.classList.remove('hidden');

      fetch(`https://viacep.com.br/ws/${cleanCep}/json/`)
        .then(res => res.json())
        .then(data => {
          loading.classList.add('hidden');
          if (data && !data.erro) {
            document.getElementById('inp-street').value = data.logradouro || document.getElementById('inp-street').value;
            document.getElementById('inp-neighborhood').value = data.bairro || document.getElementById('inp-neighborhood').value;
            document.getElementById('inp-city-state').value = `${data.localidade} - ${data.uf}`;
          }
        })
        .catch(() => loading.classList.add('hidden'));
    }

