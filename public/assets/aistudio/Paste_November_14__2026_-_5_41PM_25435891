        item.className = 'border border-slate-200 rounded p-2 bg-slate-50';
        item.innerHTML = `
          <div class="flex items-center justify-between pb-1 mb-1 border-b border-slate-200 font-bold">
            <span>${idx + 1}. ${r.name}</span>
            <span class="text-[9px] uppercase px-1.5 py-0.5 rounded ${r.condition === 'EXCELENTE' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${r.condition}</span>
          </div>
          <div class="grid grid-cols-4 gap-1 text-[10px] text-slate-700">
            <div><strong>Piso:</strong> ${r.floor}</div>
            <div><strong>Teto:</strong> ${r.ceiling}</div>
            <div><strong>Paredes:</strong> ${r.wall}</div>
            <div><strong>Esquadrias:</strong> ${r.joinery}</div>
          </div>
          ${r.notes ? `<div class="mt-1 text-[9px] text-slate-600"><strong>Observações:</strong> ${r.notes}</div>` : ''}
        `;
        roomsContainer.appendChild(item);
      });

      // Fotos no Laudo
      document.getElementById('insp-doc-photo-count').innerText = `${currentPhotos.length} Evidências Registradas`;
      const photosGrid = document.getElementById('insp-doc-photos-grid');
      photosGrid.innerHTML = '';
      currentPhotos.forEach(p => {
        const card = document.createElement('div');
        card.className = 'border border-slate-300 rounded overflow-hidden bg-slate-50 flex flex-col break-inside-avoid';
        card.innerHTML = `
          <div class="relative h-40 bg-slate-200">
            <img src="${p.url}" alt="${p.title}" class="w-full h-full object-cover">
            ${p.hasDefect ? `
              <div class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded bg-red-600 text-white font-bold text-[8px] flex items-center gap-1 shadow">
                <i data-lucide="alert-triangle" class="w-2.5 h-2.5"></i> VÍCIO (${p.severity || 'LEVE'})
              </div>
            ` : ''}
            <div class="watermark-stamp absolute bottom-1.5 right-1.5 px-2 py-0.5 rounded bg-black/80 text-[8px] text-amber-300 font-mono border border-amber-500/30">
              CRECI ${userProfile.creci} • CNAI ${userProfile.cnai} • ${p.date}
            </div>
          </div>
          <div class="p-2">
            <div class="font-bold text-slate-900 text-[10px]">${p.title}</div>
            <p class="text-[9px] text-slate-600">${p.desc}</p>
          </div>
        `;
        photosGrid.appendChild(card);
      });
      lucide.createIcons();
    }

    // Inicialização
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      renderPhotos();
      renderRooms();
      recalculateAll();
    });
  </script>
</body>
</html>
