    // Cálculo e Homogeneização Estatística
    function calcRossHeideckeK(age, usefulLife, state) {
      const coefficients = {
        NOVO: 0.0000,
        ENTRE_NOVO_REGULAR: 0.00032,
        REGULAR: 0.0252,
        ENTRE_REGULAR_REPAROS: 0.0809,
        REPAROS_SIMPLES: 0.1810,
        ENTRE_REPAROS_IMPORTANTES: 0.3260,
        REPAROS_IMPORTANTES: 0.5220,
        SEM_VALOR: 1.0000
      };
      const x = Math.min(Math.max((age || 0) / (usefulLife || 60), 0), 1.0);
      const ross = (x + Math.pow(x, 2)) / 2;
      const heidecke = coefficients[state] !== undefined ? coefficients[state] : 0.0252;
      return ross + heidecke * (1 - ross);
    }

    function recalculateAll() {
      const age = Number(document.getElementById('inp-age').value) || 12;
      const usefulLife = Number(document.getElementById('inp-useful-life').value) || 60;
      const rossState = document.getElementById('inp-ross-state').value;
      const targetArea = Number(document.getElementById('inp-private-area').value) || 165;
      const standard = document.getElementById('inp-standard').value;

      const k = calcRossHeideckeK(age, usefulLife, rossState);
      document.getElementById('label-k-percent').innerText = `${(k * 100).toFixed(2)}%`;

      fetch('/api/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          target: { ageYears: age, usefulLifeYears: usefulLife, rossHeidecke: rossState, privateArea: targetArea, standard: standard, type: 'APARTAMENTO' },
          samples: currentSamples
        })
      })
      .then(res => res.json())
      .then(data => {
        updateStatsUI(data);
      })
      .catch(err => console.error(err));
    }

